generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Doctor {
  id              String        @id @default(cuid())
  name            String
  title           String
  yearsExperience Int           @default(0)
  imageUrl        String?
  description     String
  phone           String        @unique
  email           String?       @unique
  address         String?
  facebookLink    String?
  instagramLink   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
  patients        Patient[]
  reviews         Review[]
  schedules       Schedule?

  @@index([name])
}

model Schedule {
  id        String   @id @default(cuid())
  doctorId  String   @unique
  days      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Patient {
  id           String        @id @default(cuid())
  name         String
  phone        String        @unique
  doctorId     String
  isBlocked    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([phone])
}

model Review {
  id        String       @id @default(cuid())
  doctorId  String
  content   String
  stars     Int          @default(5)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  name      String
  isBlocked Boolean      @default(false)
  doctor    Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([status])
}

model Appointment {
  id        String            @id @default(cuid())
  patientId String
  doctorId  String
  date      DateTime          @db.Date
  time      String
  status    AppointmentStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  doctor    Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date, time])
  @@index([doctorId, date])
  @@index([patientId])
  @@index([status])
}

model PushSubscription {
  id        String   @id
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}
